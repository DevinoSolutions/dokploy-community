PORT=3000
NODE_ENV=production

# Optional: social login (GitHub / Google).
# Set BETTER_AUTH_URL to your panel's public URL (e.g. https://panel.example.com)
# and register the callback URL <BETTER_AUTH_URL>/api/auth/callback/<provider>
# in the provider's OAuth app. Buttons only appear when both id + secret are set.
# BETTER_AUTH_URL=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=